# =============================================
# GIFT VIBES STORE — SERVER ENVIRONMENT CONFIG
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/giftvibes?retryWrites=true&w=majority

# --- JWT Secret (use a long, random string) ---
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# --- Admin Initial Credentials (used by seed script) ---
ADMIN_USERNAME=Rabbani12
ADMIN_PASSWORD=Abrohim239#91

# --- Server Port ---
PORT=5000

# --- CORS Origin (your frontend URL) ---
CLIENT_URL=http://localhost:5173
